#!/usr/bin/python3 -IS
"""Luddite Scout command-line scanner.

Reviews a public GitHub repository with the same checks as the web page
(js/checks/) and prints one bounded report. Standard library only.

    scout owner/repo            human-readable report
    scout --json owner/repo     JSON report, used by the Omarchy panel
    scout --agent owner/repo    JSON summary for a coding agent: rule IDs and
                                counts only, no text from the repository
    scout --token-stdin ...     read a GitHub token from stdin, never argv
    scout --gh-token ...        use the token of the signed-in GitHub CLI (gh)

It runs nothing from the scanned repository. It only talks to four fixed
HTTPS hosts, refuses redirects, caps every response while reading it, and
stops at an overall deadline.
"""

import json
import os
import re
import ssl
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor

VERSION = "0.3.2"
ALLOWED_HOSTS = {"api.github.com", "raw.githubusercontent.com", "api.osv.dev", "api.securityscorecards.dev"}
DEADLINE_SECONDS = 180
API_MAX_BYTES = 8_000_000
RAW_MAX_BYTES = 1_000_000
LOCKFILE_MAX_BYTES = 20_000_000
OSV_MAX_BYTES = 10_000_000
REPORT_MAX_FINDINGS = 200
# GitHub tokens: classic ghp_/gho_/ghu_ (40 chars) and the ghs_APPID_JWT installation
# format that the Actions GITHUB_TOKEN uses since 2026-04. That one measured 377
# chars, GitHub documents ~520 and variable, and its JWT segments add "." and "-".
# ASCII only, no whitespace or control characters.
TOKEN_MAX_CHARS = 1024
TOKEN = re.compile(r"[A-Za-z0-9_.-]{20,%d}" % TOKEN_MAX_CHARS)
SEVERITIES = ["high", "medium", "low", "info"]
RANK = {"info": 0, "low": 1, "medium": 2, "high": 3}


class ScanError(Exception):
    pass


class NotFoundError(ScanError):
    pass


class PrivateRepoError(ScanError):
    pass


class RateLimitError(ScanError):
    def __init__(self, reset):
        when = time.strftime("%H:%M", time.localtime(reset)) if reset else "later"
        super().__init__(f"GitHub API rate limit reached. It resets at {when}. A token raises the limit.")


# ------------------------------------------------------------------ input

NAME = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$")
REPO = re.compile(r"^[A-Za-z0-9._-]{1,100}$")


def parse_repo_input(value):
    s = str(value or "").strip()
    if not s:
        raise ValueError("Enter a repository URL or owner/repo.")
    s = re.sub(r"^git@github\.com:", "https://github.com/", s, flags=re.I)
    if re.match(r"^github\.com/", s, re.I):
        s = "https://" + s
    if re.match(r"^https?://", s, re.I):
        url = urllib.parse.urlsplit(s)
        if not re.fullmatch(r"(www\.)?github\.com", url.hostname or "", re.I):
            raise ValueError("Only github.com repositories are supported.")
        parts = [p for p in url.path.split("/") if p]
    else:
        parts = [p for p in s.split("/") if p]
    if len(parts) < 2:
        raise ValueError("Expected owner/repo.")
    owner, repo = parts[0], re.sub(r"\.git$", "", parts[1], flags=re.I)
    if not NAME.match(owner) or not REPO.match(repo) or repo in (".", ".."):
        raise ValueError("That owner or repository name is not valid on GitHub.")
    return {"owner": owner, "repo": repo}


# ---------------------------------------------------------------- network

class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class Net:
    def __init__(self, token=None):
        self.token = token
        self.deadline = time.monotonic() + DEADLINE_SECONDS
        self.limit = None
        self.remaining = None
        self.reset = None
        self.calls = 0
        self.token_rejected = False
        self._lock = threading.Lock()
        self._opener = urllib.request.build_opener(
            urllib.request.ProxyHandler({}),
            _NoRedirect(),
            urllib.request.HTTPSHandler(context=ssl.create_default_context()),
        )

    def _request(self, url, max_bytes, data=None, headers=None):
        parts = urllib.parse.urlsplit(url)
        if parts.scheme != "https" or parts.hostname not in ALLOWED_HOSTS:
            raise ScanError("refusing a request to a host outside the allowlist")
        left = self.deadline - time.monotonic()
        if left <= 0:
            raise ScanError("the scan ran past its overall time limit")
        req = urllib.request.Request(url, data=data, headers=headers or {}, method="POST" if data else "GET")
        req.add_header("User-Agent", f"luddite-scout/{VERSION}")
        try:
            resp = self._opener.open(req, timeout=min(15, left))
        except urllib.error.HTTPError as e:
            body = e.read(4096)
            return e.code, e.headers, body
        except (urllib.error.URLError, OSError) as e:
            raise ScanError(f"network error: {getattr(e, 'reason', e)}") from None
        with resp:
            body = resp.read(max_bytes + 1)
            if len(body) > max_bytes:
                return 413, resp.headers, b""
            return resp.status, resp.headers, body

    def api(self, path):
        headers = {"Accept": "application/vnd.github+json"}
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        status, h, body = self._request("https://api.github.com" + path, API_MAX_BYTES, headers=headers)
        with self._lock:
            self.calls += 1
            for name, attr in (("x-ratelimit-limit", "limit"), ("x-ratelimit-remaining", "remaining"), ("x-ratelimit-reset", "reset")):
                v = h.get(name) if h else None
                if v is not None and v.isdigit():
                    setattr(self, attr, int(v))
        if status == 404:
            return None
        if status in (403, 429) and self.remaining == 0:
            raise RateLimitError(self.reset)
        if status == 401 and self.token:
            # An expired or revoked token should not stop a scan of public
            # data. Drop it and carry on at the anonymous limit.
            self.token = None
            self.token_rejected = True
            return self.api(path)
        if status == 401:
            raise ScanError("GitHub rejected the request.")
        if status != 200:
            raise ScanError(f"GitHub API returned {status} for {path}.")
        return json.loads(body)

    def raw(self, owner, repo, ref, path, max_bytes=RAW_MAX_BYTES):
        quoted = "/".join(urllib.parse.quote(p, safe="") for p in path.split("/"))
        url = f"https://raw.githubusercontent.com/{owner}/{repo}/{urllib.parse.quote(ref, safe='')}/{quoted}"
        try:
            status, _, body = self._request(url, max_bytes)
        except ScanError:
            return {"skipped": "network error"}
        if status == 404:
            return {"skipped": "not found"}
        if status == 429:
            return {"skipped": "throttled by raw.githubusercontent.com"}
        if status == 413:
            return {"skipped": "over size limit"}
        if status != 200:
            return {"skipped": f"HTTP {status}"}
        if b"\x00" in body[:8000]:
            return {"skipped": "binary"}
        return {"text": body.decode("utf-8", "replace")}

    def post_json(self, url, payload, max_bytes):
        data = json.dumps(payload).encode()
        status, _, body = self._request(url, max_bytes, data=data, headers={"Content-Type": "application/json"})
        if status != 200:
            raise ScanError(f"returned {status}")
        return json.loads(body)

    def get_json(self, url, max_bytes):
        status, _, body = self._request(url, max_bytes)
        return status, (json.loads(body) if status == 200 else None)


# ------------------------------------------------------------------ text

BINARY_EXT = {
    "png", "jpg", "jpeg", "gif", "webp", "avif", "ico", "icns", "bmp", "tif", "tiff", "psd",
    "woff", "woff2", "ttf", "otf", "eot",
    "mp3", "mp4", "m4a", "wav", "ogg", "webm", "mov", "avi", "flac",
    "zip", "gz", "tgz", "bz2", "xz", "zst", "7z", "rar", "tar", "jar", "war",
    "pdf", "wasm", "exe", "dll", "so", "dylib", "a", "o", "lib", "bin", "class", "pyc",
    "node", "dmg", "pkg", "deb", "rpm", "msi", "apk", "ipa", "sqlite", "db",
}


def extension(path):
    base = path.rsplit("/", 1)[-1]
    dot = base.rfind(".")
    return base[dot + 1:].lower() if dot > 0 else ""


def truncate(s, n):
    s = str(s)
    return s[:n] + "…" if len(s) > n else s


def code_point(ch):
    return "U+%04X" % ord(ch)


def parse_jsonc(text):
    out = []
    in_string = False
    i = 0
    while i < len(text):
        c = text[i]
        if in_string:
            out.append(c)
            if c == "\\" and i + 1 < len(text):
                out.append(text[i + 1])
                i += 2
                continue
            if c == '"':
                in_string = False
        elif c == '"':
            in_string = True
            out.append(c)
        elif c == "/" and text[i + 1:i + 2] == "/":
            while i < len(text) and text[i] != "\n":
                i += 1
            out.append("\n")
            continue
        elif c == "/" and text[i + 1:i + 2] == "*":
            end = text.find("*/", i + 2)
            i = len(text) if end == -1 else end + 2
            continue
        else:
            out.append(c)
        i += 1
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", "".join(out)))


def command_text(v):
    if isinstance(v, list):
        return " ".join(str(x) for x in v)
    if isinstance(v, dict):
        return " ; ".join(command_text(x) for x in v.values())
    return str(v)


# --------------------------------------------------------------- S3 unicode

HIDDEN = re.compile("[\u00AD\u061C\u180E\u200B-\u200F\u202A-\u202E\u2060-\u2064\u2066-\u2069\uFEFF\U000e0000-\U000e007f\U000e0100-\U000e01ef]")


def classify_char(ch):
    cp = ord(ch)
    if 0x202A <= cp <= 0x202E or 0x2066 <= cp <= 0x2069:
        return "Bidirectional control", "high"
    if 0xE0000 <= cp <= 0xE007F:
        return "Tag character", "high"
    if 0xE0100 <= cp <= 0xE01EF:
        return "Variation selector supplement", "high"
    if cp in (0x200E, 0x200F, 0x061C):
        return "Direction mark", "medium"
    if cp in (0x200C, 0x200D):
        return "Zero-width joiner", "low"
    if cp == 0x00AD:
        return "Soft hyphen", "low"
    return "Zero-width or invisible character", "medium"


def _pictographic(ch):
    cp = ord(ch)
    return 0x1F000 <= cp <= 0x1FAFF or 0x2600 <= cp <= 0x27BF or 0x2B00 <= cp <= 0x2BFF or 0x2190 <= cp <= 0x21FF or cp in (0x00A9, 0x00AE, 0x203C, 0x2049, 0x2122, 0x2139)


def _emoji_join(text, i):
    if text[i] != "\u200D":
        return False
    return any(_pictographic(c) for c in text[max(0, i - 2):i]) and any(_pictographic(c) for c in text[i + 1:i + 3])


def reveal(s):
    return HIDDEN.sub(lambda m: "⟦%s⟧" % code_point(m.group(0)), s)


def scan_text(text, max_samples=10):
    counts = {}
    samples = []
    severity = None
    for m in HIDDEN.finditer(text):
        ch, i = m.group(0), m.start()
        if ch == "\uFEFF" and i == 0:
            continue
        if _emoji_join(text, i):
            continue
        kind, sev = classify_char(ch)
        counts[kind] = counts.get(kind, 0) + 1
        if severity is None or RANK[sev] > RANK[severity]:
            severity = sev
        if len(samples) < max_samples:
            line = text.count("\n", 0, i) + 1
            start = text.rfind("\n", 0, i) + 1
            end = text.find("\n", i)
            full = text[start:len(text) if end == -1 else end]
            column = i - start + 1
            frm = max(0, column - 60)
            samples.append({"line": line, "column": column, "codePoint": code_point(ch), "kind": kind,
                            "excerpt": truncate(reveal(full[frm:frm + 160]), 220)})
    return {"severity": severity, "counts": counts, "samples": samples} if severity else None


def run_unicode(ctx, max_files=4000, max_bytes=60_000_000):
    findings, notes = [], []
    for e in ctx.entries:
        hit = scan_text(e["path"], 1)
        if hit:
            findings.append({"severity": hit["severity"], "rule": "S3.hidden-in-name", "title": "Hidden character in a file or folder name",
                             "path": e["path"], "detail": "Name with markers: " + reveal(e["path"])})
    candidates = ctx.text_blobs()
    selected, budget = [], max_bytes
    for b in candidates:
        if len(selected) >= max_files or b.get("size", 0) > budget:
            break
        selected.append(b)
        budget -= b.get("size", 0)
    not_covered = len(candidates) - len(selected)
    scanned = skipped = 0
    for path, res in ctx.fetch_many([b["path"] for b in selected]):
        if "text" not in res:
            skipped += 1
            continue
        scanned += 1
        hit = scan_text(res["text"])
        if not hit:
            continue
        summary = ", ".join(f"{n} × {k}" for k, n in hit["counts"].items())
        findings.append({"severity": hit["severity"], "rule": "S3.hidden-in-file", "title": summary, "path": path,
                         "line": hit["samples"][0]["line"] if hit["samples"] else None,
                         "samples": [{"line": s["line"], "text": f"{s['codePoint']} col {s['column']}: {s['excerpt']}"} for s in hit["samples"]]})
    notes.append(f"Scanned {scanned} text files and {len(ctx.entries)} names.")
    if skipped:
        notes.append(f"{skipped} files could not be read as text (binary, too large, or not served).")
    if not_covered:
        notes.append(f"{not_covered} files not read because of the size or count cap.")
    if ctx.truncated:
        notes.append("The file list from GitHub was truncated, so some files were never listed.")
    return {"status": "partial" if not_covered or ctx.truncated else "ran", "notes": notes, "findings": findings}


# ------------------------------------------------------------ S4 workflows

UNTRUSTED = re.compile(r"github\.event\.(issue\.(title|body)|pull_request\.(title|body|head\.(ref|label|repo\.default_branch))|comment\.body|review\.body|review_comment\.body|pages\.[^.\s}]*\.page_name|commits\.[^.\s}]*\.(message|author\.(email|name))|head_commit\.(message|author\.(email|name))|discussion\.(title|body)|workflow_run\.(head_branch|display_title|head_commit\.(message|author\.(email|name))))|github\.head_ref")
PR_HEAD_REF = re.compile(r"github\.event\.pull_request\.head\.(sha|ref)|github\.head_ref|refs/pull/|github\.event\.workflow_run\.head_(sha|branch)")
SHA40 = re.compile(r"^[0-9a-f]{40}$")


def _script_lines(lines):
    i = 0
    while i < len(lines):
        m = re.match(r"^(\s*)(-\s+)?(run|script):\s*(.*)$", lines[i])
        if m:
            key_indent = len(m.group(1)) + (len(m.group(2)) if m.group(2) else 0)
            rest = m.group(4)
            if re.match(r"^[|>][+-]?\d*\s*(#.*)?$", rest):
                for j in range(i + 1, len(lines)):
                    if lines[j].strip() == "":
                        continue
                    if len(lines[j]) - len(lines[j].lstrip()) <= key_indent:
                        break
                    yield j + 1, lines[j]
            elif rest:
                yield i + 1, rest
        i += 1


def analyze_workflow(text):
    lines = re.split(r"\r?\n", text)
    findings = []
    privileged = bool(re.search(r"^\s*-?\s*['\"]?(pull_request_target|workflow_run)['\"]?\s*:?", text, re.M)) or \
        bool(re.search(r"\bon:\s*\[?[^\n]*\b(pull_request_target|workflow_run)\b", text))
    pr_target = "pull_request_target" in text
    on_pull_request = bool(re.search(r"\bpull_request(_target)?\b", text))

    if pr_target:
        idx = next((i for i, l in enumerate(lines) if "pull_request_target" in l), -1)
        findings.append({"severity": "info", "rule": "S4.pull-request-target", "title": "Uses pull_request_target, which runs with repository secrets on pull requests from forks", "line": idx + 1})

    for i, l in enumerate(lines):
        if re.match(r"^\s*ref:", l) and PR_HEAD_REF.search(l) and privileged:
            findings.append({"severity": "high", "rule": "S4.privileged-checkout", "title": "Privileged workflow checks out pull request code",
                             "detail": "A pull_request_target or workflow_run job that checks out the contributor's code can let that code run with secrets.",
                             "line": i + 1, "snippet": l.strip()})

    for line, src in _script_lines(lines):
        for m in re.finditer(r"\$\{\{([^}]*)\}\}", src):
            expr = m.group(1).strip()
            if UNTRUSTED.search(expr):
                findings.append({"severity": "high", "rule": "S4.untrusted-input-in-script", "title": "Untrusted input expanded directly into a script",
                                 "detail": f"${{{{ {expr} }}}} is controlled by whoever opens the issue, pull request or comment, and is pasted into the script before it runs.",
                                 "line": line, "snippet": src.strip()})
            elif re.search(r"github\.event\.|inputs\.", expr):
                findings.append({"severity": "low", "rule": "S4.event-input-in-script", "title": "Event or input value expanded directly into a script",
                                 "detail": f"${{{{ {expr} }}}}. Safer to pass it through an environment variable.",
                                 "line": line, "snippet": src.strip()})

    unpinned = []
    for i, l in enumerate(lines):
        m = re.match(r"^\s*(-\s+)?uses:\s*['\"]?([^@\s'\"]+)@([^\s'\"#]+)", l)
        if not m:
            continue
        action, ref = m.group(2), m.group(3)
        if action.startswith("./") or action.startswith("docker://"):
            continue
        if not SHA40.match(ref):
            unpinned.append({"line": i + 1, "text": f"{action}@{ref}"})
    if unpinned:
        n = len(unpinned)
        findings.append({"severity": "low", "rule": "S4.unpinned-action", "title": f"{n} action{'s' if n > 1 else ''} pinned to a tag or branch rather than a commit SHA",
                         "detail": "A tag can be moved to different code after you review it.", "line": unpinned[0]["line"], "samples": unpinned[:10]})

    perm = next((i for i, l in enumerate(lines) if re.match(r"^\s*permissions:\s*write-all\b", l)), -1)
    if perm != -1:
        findings.append({"severity": "medium", "rule": "S4.write-all-permissions", "title": "Grants write-all permissions to the workflow token", "line": perm + 1})
    elif not any(re.match(r"^permissions:", l) for l in lines):
        findings.append({"severity": "info", "rule": "S4.no-permissions-block", "title": "No top-level permissions block, so jobs get the repository default token permissions"})

    sh = next((i for i, l in enumerate(lines) if re.search(r"runs-on:.*self-hosted", l)), -1)
    if sh != -1 and on_pull_request:
        findings.append({"severity": "medium", "rule": "S4.self-hosted-runner", "title": "Self-hosted runner used by a workflow that pull requests can trigger", "line": sh + 1})

    inh = next((i for i, l in enumerate(lines) if re.match(r"^\s*secrets:\s*inherit\b", l)), -1)
    if inh != -1:
        findings.append({"severity": "info", "rule": "S4.secrets-inherit", "title": "Passes all secrets to a reusable workflow (secrets: inherit)", "line": inh + 1})
    return findings


def is_workflow_path(path):
    return bool(re.match(r"^\.github/workflows/[^/]+\.ya?ml$", path, re.I))


def run_workflows(ctx):
    files = [e for e in ctx.entries if e["type"] == "blob" and is_workflow_path(e["path"])]
    if not files:
        return {"status": "partial" if ctx.truncated else "ran", "notes": ["No workflow files in .github/workflows."], "findings": []}
    findings, unread = [], 0
    for path, res in ctx.fetch_many([f["path"] for f in files]):
        if "text" not in res:
            unread += 1
            continue
        for f in analyze_workflow(res["text"]):
            findings.append({**f, "path": path})
    notes = [f"Read {len(files) - unread} of {len(files)} workflow files."]
    if ctx.truncated:
        notes.append("The file list from GitHub was truncated, so some workflows may be missing.")
    return {"status": "partial" if unread or ctx.truncated else "ran", "notes": notes, "findings": findings}


# --------------------------------------------------------------- S2 agents

AGENT_KINDS = [
    (r"(^|/)CLAUDE(\.local)?\.md$", "Claude Code instructions", "markdown", re.I),
    (r"(^|/)AGENTS\.md$", "Agent instructions (AGENTS.md)", "markdown", re.I),
    (r"(^|/)GEMINI\.md$", "Gemini CLI instructions", "markdown", re.I),
    (r"(^|/)\.github/copilot-instructions\.md$", "Copilot instructions", "markdown", 0),
    (r"(^|/)\.github/instructions/.+\.md$", "Copilot instructions", "markdown", 0),
    (r"(^|/)\.cursorrules$", "Cursor rules", "markdown", 0),
    (r"(^|/)\.cursor/rules/", "Cursor rules", "markdown", 0),
    (r"(^|/)\.windsurfrules$", "Windsurf rules", "markdown", 0),
    (r"(^|/)\.clinerules(/|$)", "Cline rules", "markdown", 0),
    (r"(^|/)\.claude/settings(\.local)?\.json$", "Claude Code project settings", "claude-settings", 0),
    (r"(^|/)\.claude/(agents|commands|skills|output-styles|rules)/", "Claude Code agents, commands, skills or rules", "markdown", 0),
    (r"(^|/)\.claude/", "Claude Code project files", "other", 0),
    (r"(^|/)\.agents/", "Agent skills and files shared between tools", "markdown", 0),
    (r"(^|/)\.gemini/settings\.json$", "Gemini CLI project settings", "gemini-settings", 0),
    (r"(^|/)\.gemini/", "Gemini CLI project files", "other", 0),
    (r"(^|/)\.mcp\.json$", "MCP server config", "mcp", 0),
    (r"(^|/)\.cursor/mcp\.json$", "Cursor MCP server config", "mcp", 0),
    (r"(^|/)\.vscode/mcp\.json$", "VS Code MCP server config", "mcp", 0),
    (r"(^|/)\.vscode/tasks\.json$", "VS Code tasks", "vscode-tasks", 0),
    (r"(^|/)\.vscode/settings\.json$", "VS Code workspace settings", "vscode-settings", 0),
    (r"(^|/)\.devcontainer(\.json$|/.*devcontainer\.json$)", "Dev container config", "devcontainer", 0),
]
AGENT_KINDS = [(re.compile(p, f), label, kind) for p, label, kind, f in AGENT_KINDS]

SUSPICIOUS = [
    (re.compile(r"ignore (all |any )?(of )?(the )?(previous|prior|above|earlier) (instructions|rules)", re.I), "Tries to override earlier instructions", "S2.override-instructions"),
    (re.compile(r"do not (tell|inform|mention|show|reveal)[^.\n]{0,40}(user|human|reviewer)", re.I), "Asks the agent to hide something from the user", "S2.hide-from-user"),
    (re.compile(r"(curl|wget)[^\n|]{0,200}\|\s*(ba|z)?sh\b", re.I), "Pipes a download into a shell", "S2.download-to-shell"),
    (re.compile(r"base64\s+(-d|--decode)", re.I), "Decodes base64, a common way to hide a payload", "S2.base64-decode"),
    (re.compile(r"(exfiltrat|send (it|them|the [^.\n]{0,30}) to https?:)", re.I), "Mentions sending data out", "S2.sends-data-out"),
    (re.compile(r"(\.ssh/|id_rsa|id_ed25519|\.aws/credentials|\.netrc|\.npmrc|GITHUB_TOKEN|ANTHROPIC_API_KEY|OPENAI_API_KEY)"), "Mentions credentials or key files", "S2.credential-files"),
    (re.compile(r"(--dangerously-skip-permissions|bypassPermissions|--yolo\b|auto-?approve)", re.I), "Mentions disabling agent permission checks", "S2.permission-bypass"),
]


def classify_agent_path(path):
    for rx, label, kind in AGENT_KINDS:
        if rx.search(path):
            return {"label": label, "kind": kind}
    return None


def suspicious_lines(text):
    out = []
    for i, l in enumerate(re.split(r"\r?\n", text)):
        for rx, why, rule in SUSPICIOUS:
            if rx.search(l):
                out.append({"line": i + 1, "why": why, "rule": rule, "text": truncate(l.strip(), 200)})
    return out


def resolve_ref(from_path, target):
    """A path an agent file refers to, resolved from the file's own folder.
    Returns {"outside": True} for home, absolute or climbing paths."""
    if re.match(r"^(~|/|[A-Za-z]:[\\/]|\\\\)", target):
        return {"outside": True}
    parts = from_path.split("/")[:-1]
    for p in target.split("/"):
        if p in ("", "."):
            continue
        if p == "..":
            if not parts:
                return {"outside": True}
            parts.pop()
        else:
            parts.append(p)
    return {"path": "/".join(parts)}


IMPORT_RE = re.compile(r"(?:^|\s)@((?:\\ |[^\s`'\"()<>\[\],;])+)")
LINK_RE = re.compile(r"\]\(\s*<?([^)\s>]+)")
MENTION_RE = re.compile(r"(?:^|[\s(`\"'])((?:\.{1,2}/)?[\w./-]*\w\.(?:md|mdc|txt))(?![\w/])", re.I)
URL_RE = re.compile(r"https?://[^\s)>\]\"'`]+")
URL_CONTEXT = re.compile(r"(instruction|rules|guideline|prompt|fetch|follow|load|read)", re.I)


def agent_refs(text):
    """What a markdown instruction file points an agent at. Imports follow the
    Claude Code and Gemini CLI rule: code spans and fenced blocks are skipped."""
    out = {"imports": [], "remote": [], "links": [], "urls": [], "comments": []}
    fence = None
    in_comment = False
    for i, raw in enumerate(re.split(r"\r?\n", text)):
        line = i + 1
        fm = re.match(r"^\s*(`{3,}|~{3,})", raw)
        if fence:
            if fm and fm.group(1)[0] == fence[0] and len(fm.group(1)) >= len(fence):
                fence = None
            continue
        if fm:
            fence = fm.group(1)
            continue
        if in_comment:
            if "-->" in raw:
                in_comment = False
        elif "<!--" in raw:
            out["comments"].append({"line": line, "text": truncate(raw.strip(), 200)})
            in_comment = "-->" not in raw[raw.rindex("<!--"):]
        plain = re.sub(r"`[^`]*`", " ", raw)
        for m in IMPORT_RE.finditer(plain):
            target = re.sub(r"[.:!?]+$", "", m.group(1).replace("\\ ", " "))
            if re.match(r"^[a-z][a-z0-9+.-]*://", target, re.I):
                out["remote"].append({"line": line, "text": truncate("@" + target, 200)})
            elif target:
                out["imports"].append({"line": line, "target": target})
        for m in LINK_RE.finditer(raw):
            target = re.sub(r"[#?].*$", "", m.group(1))
            if target and not re.match(r"^[a-z][a-z0-9+.-]*:", target, re.I):
                out["links"].append({"line": line, "target": target})
        for m in MENTION_RE.finditer(raw):
            out["links"].append({"line": line, "target": m.group(1)})
        if URL_CONTEXT.search(raw):
            for m in URL_RE.finditer(raw):
                out["urls"].append({"line": line, "text": truncate(m.group(0), 200)})
    return out


def _is_outside(p):
    return resolve_ref("x", str(p)).get("outside") is True


def _ref_findings(text, followed_by_mention=False):
    refs = agent_refs(text)
    out = []
    if refs["remote"]:
        out.append({"severity": "medium", "rule": "S2.remote-import", "title": "Imports instructions from a web address, which can change after this review",
                    "samples": refs["remote"][:10]})
    if followed_by_mention:
        return out
    outside = [r for r in refs["imports"] if _is_outside(r["target"])]
    if outside:
        out.append({"severity": "high", "rule": "S2.import-outside-repo", "title": "Imports a file from outside the repository, such as your home folder",
                    "samples": [{"line": r["line"], "text": truncate("@" + r["target"], 200)} for r in outside[:10]]})
    if refs["urls"]:
        out.append({"severity": "low", "rule": "S2.web-instructions", "title": "Points the agent to instructions on the web, which can change after this review",
                    "samples": refs["urls"][:10]})
    if refs["comments"]:
        n = len(refs["comments"])
        out.append({"severity": "low", "rule": "S2.html-comments", "title": f"Has {n} HTML comment{'s' if n > 1 else ''}, which GitHub hides when it shows the file. Some agents still read HTML comments.",
                    "samples": refs["comments"][:10]})
    return out


def _mcp_findings(servers):
    out = []
    if not isinstance(servers, dict):
        return out
    for name, cfg in servers.items():
        cfg = cfg if isinstance(cfg, dict) else {}
        if cfg.get("command"):
            out.append({"severity": "high", "rule": "S2.mcp-local-program", "title": f'MCP server "{truncate(name, 60)}" launches a local program',
                        "detail": truncate(f"{cfg['command']} {command_text(cfg.get('args') or [])}", 240)})
        elif cfg.get("url") or cfg.get("httpUrl"):
            out.append({"severity": "medium", "rule": "S2.mcp-remote-url", "title": f'MCP server "{truncate(name, 60)}" connects to a remote URL', "detail": truncate(str(cfg.get("url") or cfg.get("httpUrl")), 200)})
    return out


REDIRECT_ENV = re.compile(r"(_BASE_URL|_API_URL|_ENDPOINT|_PROXY|^NODE_OPTIONS|^NODE_TLS_REJECT_UNAUTHORIZED)$", re.I)


def _directory_findings(dirs, tool):
    items = [d for d in (dirs if isinstance(dirs, list) else [dirs]) if isinstance(d, str)]
    if not items:
        return []
    outside = [d for d in items if _is_outside(d)]
    if outside:
        n = len(outside)
        title = f"Gives {tool} access to {n} folder{'s' if n > 1 else ''} outside the repository"
    else:
        n = len(items)
        title = f"Adds {n} folder{'s' if n > 1 else ''} to what {tool} reads"
    return [{"severity": "high" if outside else "low", "rule": "S2.extra-folders-outside-repo" if outside else "S2.extra-folders", "title": title,
             "samples": [{"text": truncate(d, 200)} for d in (outside or items)[:10]]}]


def context_file_names(data):
    """Gemini CLI lets a project rename its instruction file. Older versions
    used contextFileName at the top level."""
    if not isinstance(data, dict):
        return []
    ctx = data.get("context") if isinstance(data.get("context"), dict) else {}
    v = ctx.get("fileName", data.get("contextFileName"))
    return [n for n in (v if isinstance(v, list) else [v]) if isinstance(n, str) and re.fullmatch(r"[\w.-]{1,100}", n)]


def _hook_commands(hooks):
    out = []

    def walk(v):
        if isinstance(v, list):
            for x in v:
                walk(x)
        elif isinstance(v, dict):
            if isinstance(v.get("command"), str):
                out.append(v["command"])
            for x in v.values():
                walk(x)
    walk(hooks)
    return out


def analyze_agent_file(path, text):
    info = classify_agent_path(path)
    if not info:
        return []
    findings = []
    data = None
    if path.endswith(".json"):
        try:
            data = parse_jsonc(text)
        except (ValueError, IndexError):
            data = None
    if not isinstance(data, dict):
        data = None if data is None else {}
    kind = info["kind"]
    d = data or {}

    if kind == "markdown":
        findings.append({"severity": "info", "rule": "S2.instruction-file", "title": f"{info['label']}: an agent reads this as guidance"})
        findings.extend(_ref_findings(text))
    elif kind == "other":
        findings.append({"severity": "info", "rule": "S2.instruction-file", "title": f"{info['label']}: an agent reads this as guidance"})
    elif kind == "claude-settings":
        if d.get("hooks"):
            cmds = _hook_commands(d["hooks"])
            findings.append({"severity": "high", "rule": "S2.hooks", "title": "Defines Claude Code hooks, which run shell commands automatically",
                             "samples": [{"text": truncate(c, 200)} for c in cmds[:10]]})
        if d.get("enableAllProjectMcpServers") is True:
            findings.append({"severity": "high", "rule": "S2.all-mcp-servers-on", "title": "Turns on every MCP server in the project without asking"})
        if d.get("apiKeyHelper"):
            findings.append({"severity": "high", "rule": "S2.api-key-helper", "title": "Sets apiKeyHelper, a command that runs to produce an API key", "detail": truncate(d["apiKeyHelper"], 200)})
        status_line = d.get("statusLine")
        if isinstance(status_line, dict) and status_line.get("command"):
            findings.append({"severity": "medium", "rule": "S2.status-line", "title": "Sets a status line command that runs repeatedly", "detail": truncate(status_line["command"], 200)})
        perms = d.get("permissions") if isinstance(d.get("permissions"), dict) else {}
        allow = perms.get("allow") if isinstance(perms.get("allow"), list) else []
        if allow:
            bash = [p for p in allow if str(p).startswith("Bash")]
            n = len(allow)
            findings.append({"severity": "medium" if bash else "low", "rule": "S2.pre-approved-permissions",
                             "title": f"Pre-approves {n} tool permission{'s' if n > 1 else ''}" + (f", {len(bash)} for shell commands" if bash else ""),
                             "samples": [{"text": truncate(p, 200)} for p in allow[:10]]})
        if perms.get("additionalDirectories"):
            findings.extend(_directory_findings(perms["additionalDirectories"], "Claude Code"))
        env = d.get("env") if isinstance(d.get("env"), dict) else {}
        keys = [k for k in env if REDIRECT_ENV.search(k)]
        if keys:
            findings.append({"severity": "high", "rule": "S2.redirect-env", "title": "Sets environment variables that change where Claude Code sends requests or how it runs",
                             "samples": [{"text": truncate(f"{k}={command_text(env[k])}", 200)} for k in keys[:10]]})
        mode = perms.get("defaultMode")
        if mode and mode != "default":
            findings.append({"severity": "high", "rule": "S2.permission-mode", "title": f"Sets the default permission mode to {truncate(mode, 40)}"})
        if data is None:
            findings.append({"severity": "medium", "rule": "S2.unparsed-settings", "title": "Claude Code settings file that could not be parsed. Review it by hand."})
    elif kind == "mcp":
        servers = d.get("mcpServers") or d.get("servers") or {}
        if not isinstance(servers, dict):
            servers = {}
        findings.extend(_mcp_findings(servers))
        if data is None:
            findings.append({"severity": "medium", "rule": "S2.unparsed-settings", "title": "MCP config that could not be parsed. Review it by hand."})
        elif not servers:
            findings.append({"severity": "info", "rule": "S2.mcp-config-empty", "title": "MCP config with no servers listed"})
    elif kind == "gemini-settings":
        names = context_file_names(d)
        if names:
            findings.append({"severity": "low", "rule": "S2.gemini-context-file", "title": f"Tells Gemini CLI to read {', '.join(names)} as its instructions"})
        ctx = d.get("context") if isinstance(d.get("context"), dict) else {}
        dirs = ctx.get("includeDirectories", d.get("includeDirectories"))
        if dirs:
            findings.extend(_directory_findings(dirs, "Gemini CLI"))
        findings.extend(_mcp_findings(d.get("mcpServers") or {}))
        if data is None:
            findings.append({"severity": "medium", "rule": "S2.unparsed-settings", "title": "Gemini CLI settings file that could not be parsed. Review it by hand."})
    elif kind == "vscode-tasks":
        tasks = d.get("tasks") if isinstance(d.get("tasks"), list) else []
        on_open = [t for t in tasks if isinstance(t, dict) and isinstance(t.get("runOptions"), dict) and t["runOptions"].get("runOn") == "folderOpen"]
        for t in on_open:
            findings.append({"severity": "high", "rule": "S2.vscode-task-on-open", "title": "VS Code task runs automatically when the folder is opened",
                             "detail": truncate(f"{t.get('label', '')}: {command_text(t.get('command', ''))} {command_text(t.get('args') or [])}", 240)})
        if not on_open:
            n = len(tasks)
            findings.append({"severity": "info", "rule": "S2.vscode-tasks", "title": f"{n} VS Code task{'' if n == 1 else 's'} defined, none run on open"})
    elif kind == "vscode-settings":
        keys = [k for k in d if re.search(r"(path|executable|command|shell|interpreter)", k, re.I)]
        if keys:
            findings.append({"severity": "medium", "rule": "S2.vscode-settings-programs", "title": "Workspace settings point tools at programs or paths",
                             "samples": [{"text": truncate(f"{k}: {command_text(d[k])}", 200)} for k in keys[:10]]})
    elif kind == "devcontainer":
        if d.get("initializeCommand"):
            findings.append({"severity": "high", "rule": "S2.devcontainer-initialize", "title": "initializeCommand runs on your machine, outside the container", "detail": truncate(command_text(d["initializeCommand"]), 240)})
        for key in ("onCreateCommand", "updateContentCommand", "postCreateCommand", "postStartCommand", "postAttachCommand"):
            if d.get(key):
                findings.append({"severity": "medium", "rule": "S2.devcontainer-command", "title": f"{key} runs inside the container", "detail": truncate(command_text(d[key]), 240)})

    for s in suspicious_lines(text):
        findings.append({"severity": "medium", "rule": s["rule"], "title": s["why"], "line": s["line"], "snippet": s["text"]})
    return findings


TEXT_REF = re.compile(r"\.(md|mdc|txt)$", re.I)
MAX_FOLLOW = 50
MAX_IMPORT_DEPTH = 4
VIA_TEXT = {"import": "an import", "link": "a symbolic link", "mention": "a mention"}


def _is_symlink(e):
    return bool(e) and e.get("mode") == "120000"


def follow_targets(by_path, path, text, is_link):
    """Files an agent is sent to by one instruction file: its imports and the
    instruction files it links or mentions, or the target of a symbolic link."""
    out = []

    def add(p, via):
        e = by_path.get(p)
        if e and e["type"] == "blob":
            out.append({"path": p, "via": via})
        elif e and e["type"] == "tree":
            for q, f in by_path.items():
                if f["type"] == "blob" and q.startswith(p + "/") and len(out) < MAX_FOLLOW:
                    out.append({"path": q, "via": via})

    if is_link:
        r = resolve_ref(path, text.strip())
        if r.get("path"):
            add(r["path"], "link")
        return out
    refs = agent_refs(text)
    for r in refs["imports"]:
        t = resolve_ref(path, r["target"])
        if t.get("path"):
            add(t["path"], "import")
    for r in refs["links"]:
        if not TEXT_REF.search(r["target"]):
            continue
        near = resolve_ref(path, r["target"])
        root = resolve_ref("x", r["target"])
        if near.get("path") and near["path"] in by_path:
            add(near["path"], "mention")
        elif root.get("path"):
            add(root["path"], "mention")
    return out


def _base_name(p):
    return p.rsplit("/", 1)[-1]


def _pair_dir(p):
    d = p.rsplit("/", 1)[0] if "/" in p else ""
    if d == ".claude":
        return ""
    return d[:-8] if d.endswith("/.claude") else d


def _line_set(text):
    return {l.strip() for l in re.split(r"\r?\n", text) if l.strip()}


def _refers_to(by_path, src, text, dst):
    return any(t["path"] == dst for t in follow_targets(by_path, src, text, False))


def cross_check_agents(entries, texts, links, extra_names=()):
    """Checks across instruction files: symbolic links, imports of files that
    are missing, and CLAUDE.md, AGENTS.md and GEMINI.md in one folder that
    differ. texts maps each file read to its text, and links maps each
    symbolic link to its target."""
    by_path = {e["path"]: e for e in entries}
    findings = []

    for path, target in links.items():
        r = resolve_ref(path, target)
        e = by_path.get(r.get("path")) if r.get("path") else None
        if r.get("outside"):
            findings.append({"severity": "high", "rule": "S2.link-outside-repo", "title": f"Is a link to {truncate(target, 200)}, outside the repository", "path": path})
        elif e:
            findings.append({"severity": "info", "rule": "S2.link", "title": f"Is a link to {'the folder ' if e['type'] == 'tree' else ''}{r['path']}", "path": path})
        else:
            findings.append({"severity": "low", "rule": "S2.link-missing", "title": f"Is a link to {truncate(r['path'], 200)}, which is not in the repository", "path": path})

    for path, text in texts.items():
        if path in links:
            continue
        missing = []
        for r in agent_refs(text)["imports"]:
            to = resolve_ref(path, r["target"])
            if to.get("path") and to["path"] not in by_path and re.search(r"\.\w{1,8}$", to["path"]):
                missing.append(r)
        if missing:
            n = len(missing)
            findings.append({"severity": "low", "rule": "S2.import-missing",
                             "title": f"Imports {n} files that are not in the repository, so something else must create them" if n > 1
                             else "Imports a file that is not in the repository, so something else must create it",
                             "path": path, "samples": [{"line": r["line"], "text": truncate("@" + r["target"], 200)} for r in missing[:10]]})

    names = {"claude.md", "agents.md", "gemini.md", *(n.lower() for n in extra_names)}
    groups = {}
    for path in texts:
        if _base_name(path).lower() in names:
            groups.setdefault(_pair_dir(path), []).append(path)

    def effective(p):
        if p not in links:
            return p, texts[p]
        r = resolve_ref(p, links[p])
        return (r["path"], texts[r["path"]]) if r.get("path") in texts else None

    for group in groups.values():
        group.sort()
        for i in range(len(group)):
            for j in range(i + 1, len(group)):
                a, b = group[i], group[j]
                ea, eb = effective(a), effective(b)
                if not ea or not eb or ea[0] == eb[0]:
                    continue
                la, lb = _line_set(ea[1]), _line_set(eb[1])
                a_only, b_only = len(la - lb), len(lb - la)
                sa, sb = bool(suspicious_lines(ea[1])), bool(suspicious_lines(eb[1]))
                if sa != sb:
                    flagged, clean = (a, b) if sa else (b, a)
                    findings.append({"severity": "medium", "rule": "S2.only-one-flagged", "path": flagged,
                                     "title": f"Only {flagged} has lines flagged by this check, so an agent that reads {clean} instead is given different instructions"})
                if not a_only and not b_only:
                    findings.append({"severity": "info", "rule": "S2.same-instructions", "title": f"{a} and {b} give the same instructions", "path": a})
                    continue
                ab = _refers_to(by_path, ea[0], ea[1], eb[0])
                ba = _refers_to(by_path, eb[0], eb[1], ea[0])
                # When each names the other, the shorter one is the pointer.
                a_first = ab and (not ba or len(la) <= len(lb))
                if ab or ba:
                    src, dst, lf, lt = (a, b, la, lb) if a_first else (b, a, lb, la)
                    to_name = _base_name(eb[0] if a_first else ea[0])
                    own = len([l for l in lf if l not in lt and to_name not in l])
                    findings.append({"severity": "info", "rule": "S2.points-to", "path": src,
                                     "title": f"{src} points to {dst}" + (f", and adds {own} lines of its own" if own > 1 else "")})
                else:
                    findings.append({"severity": "low", "rule": "S2.instructions-differ", "path": a,
                                     "title": f"{a} and {b} differ, and neither points to the other. Different agents read different files, so review both.",
                                     "detail": f"{a_only} line{'' if a_only == 1 else 's'} only in {a}, {b_only} only in {b}."})
    return findings


def run_agents(ctx):
    by_path = {e["path"]: e for e in ctx.entries}
    files = [e for e in ctx.entries if e["type"] == "blob" and classify_agent_path(e["path"])]
    if not files:
        return {"status": "partial" if ctx.truncated else "ran", "notes": ["No agent instruction, editor task or dev container files found."], "findings": []}
    findings, texts, links, extra_names, queue = [], {}, {}, [], []
    unread = 0
    for path, res in ctx.fetch_many([f["path"] for f in files[:200]]):
        info = classify_agent_path(path)
        if "text" not in res:
            unread += 1
            findings.append({"severity": "medium", "rule": "S2.unreadable", "title": f"{info['label']}: could not be read ({res['skipped']}). Review it by hand.", "path": path})
            continue
        if _is_symlink(by_path.get(path)):
            links[path] = res["text"].strip()
            queue += [{**t, "from": path, "depth": 1} for t in follow_targets(by_path, path, res["text"], True)]
            continue
        texts[path] = res["text"]
        for f in analyze_agent_file(path, res["text"]):
            findings.append({**f, "path": path})
        if info["kind"] == "markdown":
            queue += [{**t, "from": path, "depth": 1} for t in follow_targets(by_path, path, res["text"], False)]
        if info["kind"] == "gemini-settings":
            try:
                extra_names += context_file_names(parse_jsonc(res["text"]))
            except (ValueError, IndexError):
                pass

    # Files the instruction files send an agent to are instructions as well.
    followed, capped = set(), False
    while queue:
        batch = []
        for q in queue:
            if q["path"] in texts or q["path"] in links or q["path"] in followed or classify_agent_path(q["path"]):
                continue
            if len(followed) >= MAX_FOLLOW:
                capped = True
                break
            followed.add(q["path"])
            batch.append(q)
        queue = []
        got = dict(ctx.fetch_many([q["path"] for q in batch]))
        for q in batch:
            res = got.get(q["path"]) or {}
            how = VIA_TEXT[q["via"]]
            if "text" not in res:
                unread += 1
                findings.append({"severity": "medium", "rule": "S2.unreadable", "path": q["path"],
                                 "title": f"Read by agents through {how} in {q['from']}, but could not be read ({res.get('skipped')}). Review it by hand."})
                continue
            if _is_symlink(by_path.get(q["path"])):
                links[q["path"]] = res["text"].strip()
                queue += [{**t, "from": q["path"], "depth": q["depth"] + 1} for t in follow_targets(by_path, q["path"], res["text"], True)]
                continue
            texts[q["path"]] = res["text"]
            findings.append({"severity": "info", "rule": "S2.followed-file", "title": f"Read by agents through {how} in {q['from']}", "path": q["path"]})
            for s in suspicious_lines(res["text"]):
                findings.append({"severity": "medium", "rule": s["rule"], "title": s["why"], "line": s["line"], "snippet": s["text"], "path": q["path"]})
            for f in _ref_findings(res["text"], q["via"] == "mention"):
                findings.append({**f, "path": q["path"]})
            if q["via"] != "mention" and q["depth"] < MAX_IMPORT_DEPTH:
                queue += [{**t, "from": q["path"], "depth": q["depth"] + 1}
                          for t in follow_targets(by_path, q["path"], res["text"], False) if t["via"] == "import"]

    findings += cross_check_agents(ctx.entries, texts, links, extra_names)

    n = len(files)
    notes = [f"Found {n} file{'s' if n > 1 else ''}."]
    if followed:
        notes.append(f"Followed {len(followed)} more file{'s' if len(followed) > 1 else ''} that instruction files import, link or mention.")
    if capped:
        notes.append(f"Stopped following references after {MAX_FOLLOW} files.")
    if n > 200:
        notes.append("Only the first 200 were read.")
    if ctx.truncated:
        notes.append("The file list from GitHub was truncated, so some files may be missing.")
    return {"status": "partial" if unread or capped or n > 200 or ctx.truncated else "ran", "notes": notes, "findings": findings}


# ---------------------------------------------------------------- S6 build

SKIP_DIRS = re.compile(r"(^|/)(node_modules|vendor|third_party|\.git)/")
BUILD_RULES = [
    (r"(^|/)build\.rs$", "medium", "Cargo build script, runs on every cargo build or check", "S6.cargo-build-script"),
    (r"(^|/)\.envrc$", "medium", "direnv script, runs when you enter the folder if direnv is allowed", "S6.direnv"),
    (r"(^|/)setup\.py$", "medium", "Python setup script, runs on install from source", "S6.setup-py"),
    (r"(^|/)binding\.gyp$", "medium", "Native addon build, runs during npm install", "S6.native-addon"),
    (r"(^|/)(gradlew|mvnw)$", "low", "Build tool wrapper script", "S6.build-wrapper"),
    (r"(^|/)gradle/wrapper/gradle-wrapper\.jar$", "low", "Gradle wrapper binary, runs on build", "S6.gradle-wrapper-jar"),
    (r"(^|/)\.mvn/wrapper/maven-wrapper\.jar$", "low", "Maven wrapper binary, runs on build", "S6.maven-wrapper-jar"),
    (r"(^|/)build\.gradle(\.kts)?$", "info", "Gradle build script", "S6.gradle"),
    (r"(^|/)(GNUmakefile|[Mm]akefile)$", "info", "Makefile", "S6.makefile"),
    (r"(^|/)CMakeLists\.txt$", "info", "CMake build script", "S6.cmake"),
    (r"(^|/)meson\.build$", "info", "Meson build script", "S6.meson"),
    (r"(^|/)[Jj]ustfile$|(^|/)\.justfile$", "info", "just recipes", "S6.just"),
    (r"(^|/)Taskfile\.ya?ml$", "info", "Task runner file", "S6.taskfile"),
    (r"(^|/)Rakefile$", "info", "Rake tasks", "S6.rake"),
    (r"(^|/)\.pre-commit-config\.yaml$", "info", "pre-commit hooks, run on git commit once installed", "S6.pre-commit"),
    (r"(^|/)lefthook\.ya?ml$", "info", "Lefthook git hooks", "S6.lefthook"),
    (r"(^|/)\.husky/[^/]+$", "info", "Husky git hook, installed by npm install via the prepare script", "S6.husky"),
    (r"(^|/)\.githooks/[^/]+$", "info", "Git hook script", "S6.git-hook"),
    (r"(^|/)(Dockerfile|Containerfile)(\.[^/]+)?$", "info", "Container build file", "S6.container-build"),
]
BUILD_RULES = [(re.compile(p), s, t, r) for p, s, t, r in BUILD_RULES]
INSTALL_SCRIPTS = ["preinstall", "install", "postinstall", "prepare", "prepublish", "preprepare", "postprepare"]


def classify_build_path(path):
    if SKIP_DIRS.search(path):
        return None
    for rx, sev, label, rule in BUILD_RULES:
        if rx.search(path):
            return {"severity": sev, "label": label, "rule": rule}
    return None


def install_scripts(text):
    try:
        data = json.loads(text)
    except ValueError:
        return None
    scripts = data.get("scripts") if isinstance(data, dict) and isinstance(data.get("scripts"), dict) else {}
    return [{"name": k, "command": scripts[k]} for k in INSTALL_SCRIPTS if isinstance(scripts.get(k), str)]


def run_build(ctx):
    findings = []
    blobs = [e for e in ctx.entries if e["type"] == "blob"]
    for e in blobs:
        c = classify_build_path(e["path"])
        if c:
            findings.append({"severity": c["severity"], "rule": c["rule"], "title": c["label"], "path": e["path"]})
    pkgs = [e for e in blobs if re.search(r"(^|/)package\.json$", e["path"]) and not SKIP_DIRS.search(e["path"])][:100]
    unread = 0
    for path, res in ctx.fetch_many([p["path"] for p in pkgs]):
        scripts = install_scripts(res["text"]) if "text" in res else None
        if scripts is None:
            unread += 1
            continue
        for s in scripts:
            findings.append({"severity": "medium", "rule": "S6.npm-install-script", "title": f'npm "{s["name"]}" script, runs automatically on install', "path": path, "snippet": s["command"][:240]})
    notes = [f"Checked {len(blobs)} file paths and {len(pkgs) - unread} package.json files."]
    if ctx.truncated:
        notes.append("The file list from GitHub was truncated, so some files may be missing.")
    return {"status": "partial" if unread or ctx.truncated else "ran", "notes": notes, "findings": findings}


# ---------------------------------------------------------------- S1 setup

POLICY = re.compile(r"^(\.github/|docs/)?security\.(md|markdown|txt|rst)$", re.I)


def find_security_policy(entries):
    found = [e["path"] for e in entries if e["type"] == "blob" and POLICY.match(e["path"])]
    return sorted(found, key=lambda p: 0 if p.startswith(".github/") else (2 if "/" in p else 1))


def _days(iso):
    t = time.mktime(time.strptime(iso[:19], "%Y-%m-%dT%H:%M:%S")) - time.timezone
    return int((time.time() - t) // 86400)


def run_setup(ctx):
    m = ctx.meta
    findings, notes, facts = [], [], []
    partial = False
    lic = m.get("license")
    facts.append(["Description", m.get("description") or "None"])
    facts.append(["Default branch", f"{m['default_branch']} at {ctx.sha[:12]}"])
    facts.append(["Licence", lic["spdx_id"] if lic and lic.get("spdx_id") and lic["spdx_id"] != "NOASSERTION" else ("Present, not recognised" if lic else "None detected")])
    facts.append(["Created", (m.get("created_at") or "")[:10]])
    pushed = m.get("pushed_at") or ""
    facts.append(["Last push", f"{pushed[:10]} ({_days(pushed)} days ago)" if pushed else "Unknown"])
    facts.append(["Stars / forks", f"{m.get('stargazers_count')} / {m.get('forks_count')}"])

    if m.get("archived"):
        findings.append({"severity": "info", "rule": "S1.archived", "title": "Archived. The owner no longer accepts changes."})
    if m.get("fork"):
        parent = (m.get("parent") or {}).get("full_name") or "another repository"
        findings.append({"severity": "info", "rule": "S1.fork", "title": f"Fork of {parent}. Security reports may belong upstream."})
    if not lic:
        findings.append({"severity": "low", "rule": "S1.no-licence", "title": "No licence detected. Reuse rights are unclear."})
    if pushed and _days(pushed) > 365:
        findings.append({"severity": "low", "rule": "S1.stale", "title": "No pushes in over a year"})

    policies = find_security_policy(ctx.entries)
    policy = None
    if policies:
        policy = policies[0]
        facts.append(["Security policy", ", ".join(policies)])
    else:
        res = ctx.net.raw(ctx.owner, ".github", "HEAD", "SECURITY.md")
        if "text" in res:
            policy = f"{ctx.owner}/.github/SECURITY.md"
            facts.append(["Security policy", f"Inherited from {ctx.owner}/.github"])
        else:
            facts.append(["Security policy", "None found"])
            findings.append({"severity": "medium", "rule": "S1.no-security-policy", "title": "No security policy (SECURITY.md) in the repository or the owner's .github repository"})

    try:
        pvr = ctx.net.api(f"/repos/{ctx.owner}/{ctx.repo}/private-vulnerability-reporting")
        if pvr is None:
            facts.append(["Private vulnerability reporting", "Unknown"])
            partial = True
            notes.append("GitHub did not return the private vulnerability reporting status.")
        else:
            facts.append(["Private vulnerability reporting", "Enabled" if pvr.get("enabled") else "Disabled"])
            if not pvr.get("enabled"):
                findings.append({"severity": "low" if policy else "medium", "rule": "S1.private-reporting-off", "title": "GitHub private vulnerability reporting is off. Check the security policy for another private route."})
    except RateLimitError as e:
        facts.append(["Private vulnerability reporting", "Not checked (rate limit)"])
        partial = True
        notes.append(str(e))

    pr_policy = m.get("pull_request_creation_policy")
    facts.append(["Pull requests", "Disabled" if m.get("has_pull_requests") is False else (f"Open to: {pr_policy}" if pr_policy else "Enabled")])
    try:
        pulls = ctx.net.api(f"/repos/{ctx.owner}/{ctx.repo}/pulls?state=open&per_page=100&sort=created&direction=asc")
        if isinstance(pulls, list):
            count = "100 or more" if len(pulls) == 100 else str(len(pulls))
            oldest = f", oldest opened {_days(pulls[0]['created_at'])} days ago" if pulls else ""
            facts.append(["Open pull requests", count + oldest])
    except RateLimitError:
        facts.append(["Open pull requests", "Not checked (rate limit)"])
        partial = True
    return {"status": "partial" if partial else "ran", "notes": notes, "findings": findings, "facts": facts}


# ------------------------------------------------------------ S5 lockfiles

def _toml_blocks(text):
    blocks = re.split(r"^\[\[package\]\]\s*$", text, flags=re.M)[1:]
    out = []
    for b in blocks:
        m = re.search(r"^\[", b, re.M)
        out.append(b if not m else b[:m.start()])
    return out


def _toml_value(block, key):
    m = re.search(r'^' + key + r'\s*=\s*"([^"]*)"', block, re.M)
    return m.group(1) if m else None


def parse_cargo_lock(text):
    out = []
    for b in _toml_blocks(text):
        source = _toml_value(b, "source")
        if not source or not source.startswith("registry+"):
            continue
        name, version = _toml_value(b, "name"), _toml_value(b, "version")
        if name and version:
            out.append({"ecosystem": "crates.io", "name": name, "version": version})
    return out


def parse_python_toml_lock(text):
    out = []
    for b in _toml_blocks(text):
        if re.search(r"^source\s*=\s*\{\s*(editable|virtual|path|directory)\s*=", b, re.M):
            continue
        name, version = _toml_value(b, "name"), _toml_value(b, "version")
        if name and version:
            out.append({"ecosystem": "PyPI", "name": name, "version": version})
    return out


def parse_package_lock(text):
    data = json.loads(text)
    out = []
    if data.get("packages"):
        for key, pkg in data["packages"].items():
            if not key or pkg.get("link") or not pkg.get("version"):
                continue
            idx = key.rfind("node_modules/")
            name = pkg.get("name") or (None if idx == -1 else key[idx + len("node_modules/"):])
            if name:
                out.append({"ecosystem": "npm", "name": name, "version": pkg["version"]})
    elif data.get("dependencies"):
        def walk(deps):
            for name, pkg in (deps or {}).items():
                v = pkg.get("version")
                if v and not re.match(r"^(file|link|git)", v):
                    out.append({"ecosystem": "npm", "name": name, "version": v})
                walk(pkg.get("dependencies"))
        walk(data["dependencies"])
    return out


def _split_name_version(spec):
    at = spec.rfind("@")
    if at <= 0:
        return None
    return spec[:at], spec[at + 1:]


def parse_pnpm_lock(text):
    out = []
    in_packages = False
    for line in re.split(r"\r?\n", text):
        if re.match(r"^\S", line):
            in_packages = bool(re.match(r"^(packages|snapshots):", line))
            continue
        if not in_packages:
            continue
        m = re.match(r"""^ {2}(['"]?)(/?[^\s'"]+)\1:\s*$""", line)
        if not m:
            continue
        spec = re.sub(r"\(.*$", "", re.sub(r"^/", "", m.group(2)))
        nv = _split_name_version(spec)
        if not nv:
            slash = spec.rfind("/")
            if slash > 0:
                nv = (spec[:slash], spec[slash + 1:])
        if nv and re.match(r"^\d", nv[1]):
            out.append({"ecosystem": "npm", "name": nv[0], "version": re.sub(r"_.*$", "", nv[1])})
    return out


def parse_yarn_lock(text):
    out = []
    current = None
    for line in re.split(r"\r?\n", text):
        if re.match(r"^\S", line) and line.rstrip().endswith(":") and not line.startswith("#") and not line.startswith("__metadata"):
            first = line.rstrip()[:-1].split(",")[0].strip().strip('"')
            nv = _split_name_version(first)
            current = nv[0] if nv else None
            continue
        v = re.match(r'^\s+version:?\s+"?([^"\s]+)"?\s*$', line)
        if v and current:
            out.append({"ecosystem": "npm", "name": current, "version": v.group(1)})
            current = None
    return out


def parse_requirements(text):
    out = []
    for raw in re.split(r"\r?\n", text):
        line = re.sub(r"#.*$", "", raw).strip()
        m = re.match(r"^([A-Za-z0-9][A-Za-z0-9._-]*)(\[[^\]]*\])?\s*==\s*([A-Za-z0-9._+!-]+)", line)
        if m:
            out.append({"ecosystem": "PyPI", "name": m.group(1), "version": m.group(3)})
    return out


def parse_go_sum(text):
    out = []
    for line in re.split(r"\r?\n", text):
        m = re.match(r"^(\S+)\s+(v[^\s/]+)\s+h1:", line)
        if m:
            out.append({"ecosystem": "Go", "name": m.group(1), "version": re.sub(r"\+incompatible$", "", m.group(2))})
    return out


def parse_gemfile_lock(text):
    out = []
    in_specs = False
    for line in re.split(r"\r?\n", text):
        if re.match(r"^\s{2}specs:\s*$", line):
            in_specs = True
            continue
        if re.match(r"^\S", line):
            in_specs = False
        if not in_specs:
            continue
        m = re.match(r"^ {4}([A-Za-z0-9._-]+) \(([^)\s-]+)(-[^)]*)?\)\s*$", line)
        if m:
            out.append({"ecosystem": "RubyGems", "name": m.group(1), "version": m.group(2)})
    return out


def parse_composer_lock(text):
    data = json.loads(text)
    pkgs = (data.get("packages") or []) + (data.get("packages-dev") or [])
    return [{"ecosystem": "Packagist", "name": p["name"], "version": re.sub(r"^v", "", p["version"])} for p in pkgs if p.get("name") and p.get("version")]


LOCK_PARSERS = [
    (r"(^|/)Cargo\.lock$", parse_cargo_lock),
    (r"(^|/)package-lock\.json$", parse_package_lock),
    (r"(^|/)npm-shrinkwrap\.json$", parse_package_lock),
    (r"(^|/)pnpm-lock\.yaml$", parse_pnpm_lock),
    (r"(^|/)yarn\.lock$", parse_yarn_lock),
    (r"(^|/)(poetry|uv|pdm)\.lock$", parse_python_toml_lock),
    (r"(^|/)requirements[^/]*\.txt$", parse_requirements),
    (r"(^|/)go\.sum$", parse_go_sum),
    (r"(^|/)Gemfile\.lock$", parse_gemfile_lock),
    (r"(^|/)composer\.lock$", parse_composer_lock),
]
LOCK_PARSERS = [(re.compile(p), fn) for p, fn in LOCK_PARSERS]


def lockfile_parser(path):
    if SKIP_DIRS.search(path):
        return None
    for rx, fn in LOCK_PARSERS:
        if rx.search(path):
            return fn
    return None


# ------------------------------------------------------------ S5 deps

def _osv_severity(v):
    """The record's own severity, or None when it does not give one."""
    s = str(((v or {}).get("database_specific") or {}).get("severity") or "").lower()
    if s in ("critical", "high"):
        return "high"
    if s in ("moderate", "medium"):
        return "medium"
    if s == "low":
        return "low"
    return None


def advisory_findings(hits, details):
    """One finding per package. IDs that alias each other (either record lists
    the other) are one advisory: counted once, shown once, scored as the worst
    severity any member states, or medium when none states one. An ID without
    fetched details joins a group only when a fetched member lists it.
    `details` maps an ID to its OSV record."""
    order = ["high", "medium", "low"]
    findings = []
    for h in hits:
        parent = {i: i for i in h["ids"]}

        def find(i):
            while parent[i] != i:
                i = parent[i]
            return i
        for vid in h["ids"]:
            for a in (details.get(vid) or {}).get("aliases") or []:
                if a in parent:
                    parent[find(a)] = find(vid)
        groups = {}
        for vid in h["ids"]:
            groups.setdefault(find(vid), []).append(vid)
        advisories = []
        for members in groups.values():
            vid = next((m for m in members if m.startswith("GHSA-")), members[0])
            v = details.get(vid) or {}
            aliases = [a for a in dict.fromkeys(members + list(v.get("aliases") or [])) if a != vid]
            known = [s for s in (_osv_severity(details.get(m)) for m in members) if s]
            severity = min(known, key=order.index) if known else "medium"
            summary = v.get("summary") or next(((details.get(m) or {}).get("summary") for m in members if (details.get(m) or {}).get("summary")), None)
            advisories.append({"id": vid, "aliases": aliases, "severity": severity, "summary": summary})
        worst = min((a["severity"] for a in advisories), key=order.index, default="low")
        p = h["pkg"]
        n = len(advisories)
        samples = []
        for a in advisories[:8]:
            text = a["id"] + (f" ({', '.join(a['aliases'][:3])})" if a["aliases"] else "") + (f": {a['summary']}" if a["summary"] else "")
            samples.append({"text": truncate(text, 300), "osv": a["id"]})
        findings.append({"severity": worst, "rule": "S5.known-advisories",
                         "title": f"{p['name']} {p['version']} ({p['ecosystem']}): {n}{'+' if h['more'] else ''} known advisor{'y' if n == 1 else 'ies'}",
                         "path": p["paths"][0], "samples": samples})
    return findings


def fetch_scorecard(net, owner, repo):
    try:
        status, data = net.get_json(f"https://api.securityscorecards.dev/projects/github.com/{owner}/{repo}", 2_000_000)
    except ScanError:
        return {"state": "error", "message": "Scorecard could not be reached."}
    if status == 404:
        return {"state": "not-scanned"}
    if status != 200 or not isinstance(data, dict):
        return {"state": "error", "message": f"Scorecard returned {status}."}
    return {"state": "ok", "score": data.get("score"), "date": data.get("date"),
            "checks": [{"name": c.get("name"), "score": c.get("score"), "reason": c.get("reason")} for c in (data.get("checks") or [])[:40]]}


def run_deps(ctx):
    notes, findings = [], []
    scorecard = fetch_scorecard(ctx.net, ctx.owner, ctx.repo)
    if scorecard["state"] == "not-scanned":
        notes.append("Not scanned by OpenSSF Scorecard. That is common and is not a failure.")
    elif scorecard["state"] == "error":
        notes.append(scorecard["message"])
    elif scorecard["state"] == "ok":
        notes.append(f"OpenSSF Scorecard: {scorecard['score']} / 10 ({str(scorecard['date'])[:10]}).")

    lockfiles = [e for e in ctx.entries if e["type"] == "blob" and lockfile_parser(e["path"])]
    if not lockfiles:
        notes.insert(0, "No supported lockfiles found (Cargo, npm, pnpm, Yarn, Poetry, uv, PDM, pip requirements, Go, Bundler, Composer).")
        return {"status": "partial" if ctx.truncated else "ran", "notes": notes, "findings": findings, "scorecard": scorecard}

    packages = {}
    unreadable = 0
    for path, res in ctx.fetch_many([l["path"] for l in lockfiles], max_bytes=LOCKFILE_MAX_BYTES):
        if "text" not in res:
            unreadable += 1
            continue
        try:
            for p in lockfile_parser(path)(res["text"]):
                key = f"{p['ecosystem']}|{p['name']}|{p['version']}"
                packages.setdefault(key, {**p, "paths": []})["paths"].append(path)
        except (ValueError, KeyError, AttributeError, TypeError):
            unreadable += 1
    notes.insert(0, f"Read {len(lockfiles) - unreadable} of {len(lockfiles)} lockfiles, {len(packages)} unique package versions.")

    plist = list(packages.values())
    hits, osv_failed = [], False
    try:
        for i in range(0, len(plist), 1000):
            chunk = plist[i:i + 1000]
            data = ctx.net.post_json("https://api.osv.dev/v1/querybatch",
                                     {"queries": [{"package": {"name": p["name"], "ecosystem": p["ecosystem"]}, "version": p["version"]} for p in chunk]},
                                     OSV_MAX_BYTES)
            for j, r in enumerate((data.get("results") or [])[:len(chunk)]):
                vulns = (r or {}).get("vulns") or []
                if vulns:
                    hits.append({"pkg": chunk[j], "ids": [str(v.get("id")) for v in vulns], "more": bool(r.get("next_page_token"))})
    except (ScanError, ValueError) as e:
        osv_failed = True
        notes.append(f"Advisory lookup failed: {e}. Lockfiles were read but not checked.")

    ids = list(dict.fromkeys(i for h in hits for i in h["ids"]))
    details = {}

    def detail(vid):
        try:
            status, data = ctx.net.get_json(f"https://api.osv.dev/v1/vulns/{urllib.parse.quote(vid, safe='')}", 1_000_000)
            return vid, data if status == 200 else None
        except ScanError:
            return vid, None
    with ThreadPoolExecutor(6) as ex:
        for vid, data in ex.map(detail, ids[:60]):
            details[vid] = data
    if len(ids) > 60:
        notes.append(f"{len(ids)} advisories matched. Details were fetched for the first 60.")

    findings.extend(advisory_findings(hits, details))
    if ctx.truncated:
        notes.append("The file list from GitHub was truncated, so some lockfiles may be missing.")
    return {"status": "partial" if osv_failed or unreadable or ctx.truncated else "ran", "notes": notes, "findings": findings, "scorecard": scorecard}


# --------------------------------------------------------- S7 Omarchy plugin

CODE_EXT = re.compile(r"\.(qml|js|mjs|sh|bash|py)$", re.I)
PLUGIN_BINARY = re.compile(r"\.(so|dylib|dll|exe|node|wasm|pyc|qsb|a|o)$", re.I)
QML_JS = re.compile(r"\.(qml|js|mjs)$", re.I)
PLUGIN_RULES = [
    (r"\b(curl|wget)\b[^|\n]*\|\s*(sudo\s+)?(ba|z|da)?sh\b", "high", "Downloads and runs a script in one step", CODE_EXT, "S7.download-and-run"),
    (r"\b(sudo|pkexec)\b", "high", "Uses sudo or pkexec", CODE_EXT, "S7.sudo"),
    (r"\bsetcap\b|\bchmod\s+[0-7]*[46][0-7]{3}\b", "high", "Changes file capabilities or setuid bits", CODE_EXT, "S7.setuid"),
    (r"\bStdioCollector\b", "medium", "Collects a child process's whole output before checking its size", re.compile(r"\.qml$", re.I), "S7.stdio-collector"),
    (r"""["'](ba)?sh["']\s*,\s*["']-l?c["']|\bexecDetached\(\s*["'`]|\bbar\.run\(""", "medium", "Runs a shell command string rather than an argument list", QML_JS, "S7.shell-string"),
    (r"\bshell\s*=\s*True\b|\bos\.system\(", "medium", "Runs a shell command string from Python", re.compile(r"\.py$", re.I), "S7.python-shell"),
    (r"\bXMLHttpRequest\b", "medium", "Makes network requests from inside the shared shell process", QML_JS, "S7.xhr"),
    (r"\bcurl\b[^\n]*\s(-L|--location|-k|--insecure)\b|verify\s*=\s*False|CERT_NONE", "medium", "Follows redirects or skips TLS verification", CODE_EXT, "S7.insecure-fetch"),
    (r"""Authorization:\s*Bearer\s*\$|-u\s+["']?\$\w+:|\btoken=\$""", "medium", "May put a credential on a command line, where other processes can read it", CODE_EXT, "S7.credential-on-command-line"),
    (r"releases/latest|\bgit\s+(clone|pull)\b|\b(pip|pipx|npm|cargo|go)\s+install\b|\b(yay|paru)\s+-S|\bpacman\s+-S", "medium", "Installs or fetches code at run time", CODE_EXT, "S7.runtime-install"),
    (r"\bsystemctl\s+(?!--user)(enable|start|restart|disable|stop|mask)\b", "medium", "Changes system services", CODE_EXT, "S7.system-services"),
    (r"""["'`]/tmp/|\$\{XDG_RUNTIME_DIR:-""", "low", "Uses a predictable shared temporary path", CODE_EXT, "S7.shared-tmp"),
]
PLUGIN_RULES = [(re.compile(p), s, t, f, r) for p, s, t, f, r in PLUGIN_RULES]


def read_manifest(text):
    try:
        data = json.loads(text)
    except ValueError:
        return None
    if not isinstance(data, dict) or "schemaVersion" not in data or not (data.get("entryPoints") or data.get("kinds")):
        return None
    return data


def text_sinks_without_format(src):
    # A use of an inline component declared in the same file inherits its
    # textFormat, so only the declaration is checked.
    lines = []
    local = set(re.findall(r"\bcomponent\s+(\w+)\s*:", src))
    for m in re.finditer(r"\b(Text|Label|TextEdit)\s*\{", src):
        if m.group(1) in local:
            continue
        i, depth = m.end(), 1
        while i < len(src) and depth:
            if src[i] == "{":
                depth += 1
            elif src[i] == "}":
                depth -= 1
            i += 1
        if not re.search(r"\btextFormat\s*:", src[m.end():i]):
            lines.append(src.count("\n", 0, m.start()) + 1)
    return lines


def analyze_plugin_file(path, text):
    findings = []
    file_lines = re.split(r"\r?\n", text)
    for rx, sev, title, filt, rule in PLUGIN_RULES:
        if not filt.search(path):
            continue
        hits = [{"line": i + 1, "text": l.strip()[:200]} for i, l in enumerate(file_lines)
                if not re.match(r"^\s*(//|#|\*|/\*)", l) and rx.search(l)]
        if hits:
            findings.append({"severity": sev, "rule": rule, "title": title, "path": path, "line": hits[0]["line"], "samples": hits[:5], "count": len(hits)})
    if re.search(r"\.qml$", path, re.I):
        missing = text_sinks_without_format(text)
        if missing:
            n = len(missing)
            findings.append({"severity": "medium", "rule": "S7.text-without-format", "title": f"{n} Text item{'s' if n > 1 else ''} without textFormat: Text.PlainText",
                             "detail": "Without it Qt may render markup, including image tags that make the shell fetch a URL.",
                             "path": path, "line": missing[0], "samples": [{"line": l, "text": "Text without textFormat"} for l in missing[:5]], "count": n})
    return findings


def analyze_plugin_tree(entries, readme):
    findings = []
    blobs = [e for e in entries if e["type"] == "blob"]
    if len(blobs) > 1000:
        findings.append({"severity": "medium", "rule": "S7.too-many-files", "title": f"{len(blobs)} files, over the marketplace scanner's limit of 1000"})
    for b in blobs:
        if b.get("size", 0) > 512 * 1024 and b["path"] != "preview.png":
            findings.append({"severity": "medium", "rule": "S7.large-file", "title": "File over the marketplace scanner's 512 KiB limit", "path": b["path"]})
        if PLUGIN_BINARY.search(b["path"]):
            findings.append({"severity": "medium", "rule": "S7.binary", "title": "Compiled binary in the plugin, which reviewers cannot inspect", "path": b["path"]})
    agent_files = [b for b in blobs if classify_agent_path(b["path"])]
    if agent_files:
        findings.append({"severity": "medium", "rule": "S7.agent-files", "title": "Agent instruction files are installed with the plugin, into a folder coding agents read automatically",
                         "samples": [{"text": b["path"]} for b in agent_files[:10]]})
    if not any(re.match(r"^preview\.(png|jpe?g|webp|avif)$", b["path"], re.I) for b in blobs):
        findings.append({"severity": "info", "rule": "S7.no-preview", "title": "No preview image at the root"})
    if readme is not None and not re.search(r"omarchy plugin remove\b", readme):
        findings.append({"severity": "low", "rule": "S7.no-removal-docs", "title": "README does not explain removal with omarchy plugin remove"})
    return findings


def run_omarchy(ctx):
    if not any(e["type"] == "blob" and e["path"] == "manifest.json" for e in ctx.entries):
        return {"status": "not-applicable", "notes": ["Not an Omarchy plugin: there is no manifest.json at the root."], "findings": []}
    res = ctx.fetch_text("manifest.json")
    manifest = read_manifest(res["text"]) if "text" in res else None
    if not manifest:
        return {"status": "not-applicable", "notes": ["manifest.json is not an Omarchy plugin manifest."], "findings": []}
    kinds = manifest.get("kinds")
    facts = [["Plugin id", str(manifest.get("id", "missing"))], ["Name", str(manifest.get("name", "missing"))],
             ["Version", str(manifest.get("version", "missing"))], ["Kinds", ", ".join(map(str, kinds)) if isinstance(kinds, list) else "missing"]]
    readme_entry = next((e for e in ctx.entries if e["type"] == "blob" and re.match(r"^readme(\.md)?$", e["path"], re.I)), None)
    readme = ctx.fetch_text(readme_entry["path"]).get("text") if readme_entry else None
    findings = analyze_plugin_tree(ctx.entries, readme)
    code = [e for e in ctx.entries if e["type"] == "blob" and CODE_EXT.search(e["path"]) and e.get("size", 0) <= 1_000_000][:500]
    unread = 0
    for path, r in ctx.fetch_many([c["path"] for c in code]):
        if "text" not in r:
            unread += 1
            continue
        findings.extend(analyze_plugin_file(path, r["text"]))
    notes = ["Omarchy plugin detected. These checks follow the marketplace review rules and are pattern matches, not a review.",
             f"Read {len(code) - unread} of {len(code)} code files."]
    return {"status": "partial" if unread or ctx.truncated else "ran", "notes": notes, "findings": findings, "facts": facts}


# ------------------------------------------------------------------- scan

CHECKS = [
    ("S1", "Repository setup", run_setup),
    ("S2", "Agent instruction files", run_agents),
    ("S3", "Hidden Unicode", run_unicode),
    ("S4", "GitHub Actions", run_workflows),
    ("S5", "Dependencies", run_deps),
    ("S6", "Build-time code", run_build),
    ("S7", "Omarchy plugin", run_omarchy),
]
RUN_ORDER = ["S1", "S2", "S4", "S6", "S7", "S5", "S3"]


class Context:
    def __init__(self, net, owner, repo, meta, sha, tree):
        self.net, self.owner, self.repo, self.meta, self.sha = net, owner, repo, meta, sha
        self.entries = [e for e in tree.get("tree", []) if isinstance(e, dict) and isinstance(e.get("path"), str)]
        self.truncated = bool(tree.get("truncated"))
        self._cache = {}
        self._lock = threading.Lock()

    def text_blobs(self):
        return [e for e in self.entries if e["type"] == "blob" and extension(e["path"]) not in BINARY_EXT and e.get("size", 0) <= RAW_MAX_BYTES]

    def fetch_text(self, path, max_bytes=RAW_MAX_BYTES):
        key = (path, max_bytes)
        with self._lock:
            if key in self._cache:
                return self._cache[key]
        res = self.net.raw(self.owner, self.repo, self.sha, path, max_bytes)
        with self._lock:
            self._cache[key] = res
        return res

    def fetch_many(self, paths, max_bytes=RAW_MAX_BYTES):
        with ThreadPoolExecutor(12) as ex:
            return list(zip(paths, ex.map(lambda p: self.fetch_text(p, max_bytes), paths)))


def _bound_result(result):
    findings = sorted(result.get("findings", []), key=lambda f: SEVERITIES.index(f["severity"]))
    if len(findings) > REPORT_MAX_FINDINGS:
        result.setdefault("notes", []).append(f"{len(findings) - REPORT_MAX_FINDINGS} lower-severity findings were left out of this report.")
        findings = findings[:REPORT_MAX_FINDINGS]
    for f in findings:
        for k in ("title", "detail", "snippet", "path"):
            if f.get(k) is not None:
                f[k] = truncate(f[k], 400)
        if f.get("samples"):
            f["samples"] = [{**s, "text": truncate(s.get("text", ""), 300)} for s in f["samples"][:10]]
    result["findings"] = findings
    return result


def scan(target, token=None):
    ids = parse_repo_input(target)
    net = Net(token)
    owner, repo = ids["owner"], ids["repo"]
    meta = net.api(f"/repos/{owner}/{repo}")
    if not meta:
        raise NotFoundError(f"{owner}/{repo} was not found. It may be private, renamed, or misspelled.")
    if meta.get("private"):
        raise PrivateRepoError("This repository is private. Luddite Scout only reviews public repositories.")
    branch = net.api(f"/repos/{owner}/{repo}/branches/{urllib.parse.quote(meta['default_branch'], safe='')}")
    if not branch:
        raise ScanError("The default branch could not be read.")
    sha = branch["commit"]["sha"]
    if not SHA40.match(sha):
        raise ScanError("GitHub returned an unexpected commit id.")
    tree = net.api(f"/repos/{owner}/{repo}/git/trees/{sha}?recursive=1")
    if not tree:
        raise ScanError("The file list could not be read.")
    owner, repo = meta["owner"]["login"], meta["name"]
    ctx = Context(net, owner, repo, meta, sha, tree)

    results = {}
    for cid in RUN_ORDER:
        cid_, name, fn = next(c for c in CHECKS if c[0] == cid)
        try:
            results[cid] = _bound_result(fn(ctx))
        except RateLimitError as e:
            results[cid] = {"status": "skipped", "notes": [str(e)], "findings": []}
        except Exception as e:  # one check failing must not hide the others
            results[cid] = {"status": "skipped", "notes": [f"This check failed: {truncate(e, 200)}"], "findings": []}

    return {
        "tool": "luddite-scout", "version": VERSION,
        "repository": f"{owner}/{repo}", "commit": sha,
        "api": {"calls": net.calls, "remaining": net.remaining, "limit": net.limit,
                "authenticated": net.token is not None, "tokenRejected": net.token_rejected},
        "checks": [{"id": cid, "name": name, **results[cid]} for cid, name, _ in CHECKS],
    }


# ------------------------------------------------------------------- output

# The readable report and error messages quote text the scanned repository
# controls: names, paths, titles and facts. A terminal acts on control
# characters (an OSC 52 sequence can write the clipboard), so every C0 and C1
# control, DEL, line and paragraph separator, and every HIDDEN character is
# shown as ⟦U+XXXX⟧ instead. JSON escapes C0 itself, and the rest is escaped as
# \uXXXX so the report stays inert when printed and parses to the same text.
TERMINAL_UNSAFE = re.compile("[\x00-\x1f\x7f-\x9f\u2028\u2029]|" + HIDDEN.pattern)


def term_safe(v):
    return TERMINAL_UNSAFE.sub(lambda m: "⟦%s⟧" % code_point(m.group(0)), str(v))


def json_safe(out):
    return TERMINAL_UNSAFE.sub(lambda m: json.dumps(m.group(0))[1:-1], out)


def format_text(report):
    out = [f"{report['repository']} at {report['commit']}"]
    for c in report["checks"]:
        counts = {}
        for f in c["findings"]:
            counts[f["severity"]] = counts.get(f["severity"], 0) + 1
        summary = ", ".join(f"{counts[s]} {s}" for s in SEVERITIES if counts.get(s))
        out.append("")
        out.append(f"{c['id']} {c['name']}: {c['status']}" + (f" ({summary})" if summary else ""))
        for n in c.get("notes", []):
            out.append(f"  {n}")
        for k, v in c.get("facts", []):
            out.append(f"  {k}: {v}")
        for f in c["findings"]:
            loc = f" [{f['path']}{':' + str(f['line']) if f.get('line') else ''}]" if f.get("path") else ""
            out.append(f"  {f['severity'].upper():6} {f['title']}{loc}")
    api = report["api"]
    out.append("")
    who = "signed in" if api.get("authenticated") else "anonymous"
    out.append(f"GitHub API ({who}): {api['calls']} requests used, {api['remaining']} of {api['limit']} left this hour.")
    if api.get("tokenRejected"):
        out.append("GitHub rejected the token, so the scan continued without it.")
    return "\n".join(term_safe(line) for line in out)


JSON_MAX_CHARS = 1_500_000


# The Omarchy panel refuses output over 2,000,000 characters, so the JSON
# report drops its lowest-severity findings until it fits well under that.
def bounded_json(report):
    out = json_safe(json.dumps(report, ensure_ascii=False))
    while len(out) > JSON_MAX_CHARS:
        longest = max(report["checks"], key=lambda c: len(c["findings"]))
        if not longest["findings"]:
            break
        keep = len(longest["findings"]) // 2
        longest.setdefault("notes", []).append(f"{len(longest['findings']) - keep} lower-severity findings were left out to keep the report small.")
        longest["findings"] = longest["findings"][:keep]
        out = json_safe(json.dumps(report, ensure_ascii=False))
    return out


# --agent output is for a coding agent that must not read text the scanned
