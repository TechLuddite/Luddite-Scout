STATUSES = {"ran", "partial", "skipped", "not-applicable"}
AGENT_NOTICE = ("This output contains no text from the scanned repository, by design. Rule descriptions are "
                "fixed strings written by Luddite Scout. File names, contents and line text are withheld. "
                "A result with no findings is not proof that the repository is safe.")
AGENT_HANDOFF = ("For details, the user runs the full_report command in their own terminal, outside the agent "
                 "session. Do not run it, do not fetch, clone or open the repository, and do not ask for its contents.")
AGENT_ERRORS = {
    "invalid-input": "The repository name was not valid. Use owner/repo or a github.com URL.",
    "not-found": "The repository was not found. It may be private, renamed or misspelled.",
    "private": "The repository is private. Luddite Scout only reviews public repositories.",
    "rate-limit": "GitHub's API rate limit was reached. Try again later or sign in to the GitHub CLI.",
    "scan-failed": "The scan could not complete. The user can run the full report in their own terminal to see why.",
    "guard": "The agent report failed its own safety check and was withheld. The user can run the full report in their own terminal.",
}


class AgentGuardError(Exception):
    pass


def _safe_owner_repo(owner, repo):
    return bool(NAME.match(str(owner))) and bool(REPO.match(str(repo))) and repo not in (".", "..")


def agent_report(report, command):
    """The report with every repository-controlled string removed. Findings
    are grouped by rule and counted. Raises AgentGuardError if any string in
    the result is outside the allowlist."""
    owner, _, repo = report["repository"].partition("/")
    if not _safe_owner_repo(owner, repo) or not SHA40.match(report["commit"]):
        raise AgentGuardError()
    highest = None
    complete = True
    checks = []
    for c in report["checks"]:
        status = c["status"] if c["status"] in STATUSES else "skipped"
        if status in ("partial", "skipped"):
            complete = False
        groups = {}
        for f in c["findings"]:
            rule = f.get("rule") if f.get("rule") in RULES else "unclassified"
            sev = f["severity"] if f["severity"] in RANK else "info"
            g = groups.setdefault((rule, sev), {"rule": rule, "severity": sev, "count": 0, "description": RULES[rule]})
            g["count"] += 1
            if highest is None or RANK[sev] > RANK[highest]:
                highest = sev
        rules = sorted(groups.values(), key=lambda g: (SEVERITIES.index(g["severity"]), g["rule"]))
        counts = {s: sum(g["count"] for g in rules if g["severity"] == s) for s in SEVERITIES}
        entry = {"id": c["id"], "name": c["name"], "status": status, "counts": counts, "rules": rules}
        sc = c.get("scorecard") or {}
        if sc.get("state") == "ok" and isinstance(sc.get("score"), (int, float)) and not isinstance(sc.get("score"), bool):
            entry["scorecard"] = sc["score"]
        checks.append(entry)
    out = {"tool": "luddite-scout", "version": VERSION, "mode": "agent",
           "repository": f"{owner}/{repo}", "commit": report["commit"],
           "highest_severity": highest, "complete": complete, "checks": checks,
           "full_report": command, "notice": AGENT_NOTICE, "handoff": AGENT_HANDOFF}
    _guard(out, command)
    return out


def _guard(value, command):
    allowed = (set(RULES) | set(RULES.values()) | STATUSES | set(SEVERITIES) | {name for _, name, _ in CHECKS}
               | {cid for cid, _, _ in CHECKS} | {"luddite-scout", "agent", VERSION, AGENT_NOTICE, AGENT_HANDOFF, command}
               | set(AGENT_ERRORS) | set(AGENT_ERRORS.values()))
    keys = {"tool", "version", "mode", "repository", "commit", "highest_severity", "complete", "checks", "full_report",
            "notice", "handoff", "id", "name", "status", "counts", "rules", "rule", "severity", "count", "description",
            "scorecard", "error", "message", *SEVERITIES}

    def walk(v, key):
        if isinstance(v, dict):
            for k, x in v.items():
                if k not in keys:
                    raise AgentGuardError()
                walk(x, k)
        elif isinstance(v, list):
            for x in v:
                walk(x, key)
        elif isinstance(v, str):
            if key == "repository":
                o, _, r = v.partition("/")
                ok = _safe_owner_repo(o, r)
            elif key == "commit":
                ok = bool(SHA40.match(v))
            else:
                ok = v in allowed
            if not ok:
                raise AgentGuardError()
        elif not (v is None or isinstance(v, (bool, int, float))):
            raise AgentGuardError()
    walk(value, None)


def agent_error(code):
    out = {"tool": "luddite-scout", "version": VERSION, "mode": "agent", "error": code, "message": AGENT_ERRORS[code]}
    _guard(out, "")
    return out


def full_report_command(target):
    """The command the user runs in their own terminal for the full report.
    Built from this script's own path and the validated owner/repo."""
    ids = parse_repo_input(target)
    script = os.path.realpath(sys.argv[0] if sys.argv and sys.argv[0] else __file__)
    if not re.fullmatch(r"[A-Za-z0-9._/+-]{1,400}", script):
        script = "scout"
    return f"python3 -I -S {script} {ids['owner']}/{ids['repo']}"


def gh_executable():
    """The GitHub CLI the user runs by default, without installing anything.

    Omarchy installs gh through mise, and its ~/.local/bin/gh wrapper runs
    `mise use -g gh`, which can download and upgrade. `mise which gh` only
    reports the binary mise would run, so it is asked first, from the home
    directory so a project-local mise.toml in the current folder cannot
    redirect it. A system package at /usr/bin/gh is the fallback.
    """
    home = os.path.expanduser("~")
    env = {"HOME": home, "PATH": "/usr/bin:/bin"}
    if os.path.isfile("/usr/bin/mise"):
        try:
            out = subprocess.run(["/usr/bin/mise", "which", "gh"], cwd=home, env=env, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10).stdout[:4096]
            path = out.decode("utf-8", "replace").strip()
            if path.startswith("/") and "\n" not in path and os.path.isfile(path) and os.access(path, os.X_OK):
                return path
        except (OSError, subprocess.SubprocessError):
            pass
    if os.path.isfile("/usr/bin/gh") and os.access("/usr/bin/gh", os.X_OK):
        return "/usr/bin/gh"
    return None


def gh_token():
    """Token of the GitHub CLI's active account, or None. Read from gh's
    stdout into this process only: never placed in an argument list, an
    environment variable, a file or the report."""
    gh = gh_executable()
    if not gh:
        return None
    home = os.path.expanduser("~")
    env = {"HOME": home, "PATH": "/usr/bin:/bin", "GH_PROMPT_DISABLED": "1", "GH_NO_UPDATE_NOTIFIER": "1"}
    for name in ("XDG_CONFIG_HOME", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS"):
        if os.environ.get(name):
            env[name] = os.environ[name]
    try:
        out = subprocess.run([gh, "auth", "token", "--hostname", "github.com"], cwd=home, env=env, stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10).stdout[:TOKEN_MAX_CHARS + 2]
    except (OSError, subprocess.SubprocessError):
        return None
    token = out.decode("ascii", "replace").strip()
    return token if TOKEN.fullmatch(token) else None


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    flags = {a for a in argv if a.startswith("--")}
    unknown = flags - {"--json", "--agent", "--token-stdin", "--gh-token", "--help", "--version"}
    if "--help" in flags or unknown or len(args) != 1:
        if "--version" in flags and not args:
            print(VERSION)
            return 0
        print(__doc__.strip(), file=sys.stderr)
        return 0 if "--help" in flags else 2
    token = None
    if "--token-stdin" in flags:
        token = sys.stdin.readline(TOKEN_MAX_CHARS + 2).strip() or None
        if token and not TOKEN.fullmatch(token):
            print("That does not look like a GitHub token.", file=sys.stderr)
            return 2
    elif "--gh-token" in flags:
        token = gh_token()
    if "--agent" in flags:
        return agent_main(args[0], token)
    try:
        report = scan(args[0], token)
    except ValueError as e:
        msg, code = str(e), 2
    except ScanError as e:
        msg, code = str(e), 1
    else:
        if "--json" in flags:
            print(bounded_json(report))
        else:
            print(format_text(report))
        return 0
    if "--json" in flags:
        print(json.dumps({"tool": "luddite-scout", "version": VERSION, "error": msg}))
    else:
        print(term_safe(msg), file=sys.stderr)
    return code


def agent_main(target, token):
    """--agent: prints only agent_report() or agent_error(). Nothing from the
    scan reaches stdout or stderr except through that allowlist."""
    try:
        command = full_report_command(target)
        out = agent_report(scan(target, token), command)
        code = 0
    except ValueError:
        out, code = agent_error("invalid-input"), 2
    except NotFoundError:
        out, code = agent_error("not-found"), 1
    except PrivateRepoError:
        out, code = agent_error("private"), 1
    except RateLimitError:
        out, code = agent_error("rate-limit"), 1
    except AgentGuardError:
        out, code = agent_error("guard"), 1
    except Exception:  # any other failure text may quote the repository
        out, code = agent_error("scan-failed"), 1
    print(json.dumps(out, ensure_ascii=True, indent=1))
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
